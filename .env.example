# -------------------------------------------------------------
# Legal Intelligence Hub — Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment
# -------------------------------------------------------------

# Application
PROJECT_NAME="Legal Intelligence Hub"
ENVIRONMENT="development"

# Security & JWT Authentication
# Generate a secure 32+ character key (e.g. `openssl rand -hex 32`)
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default (local SQLite for zero-setup development):
DATABASE_URL="sqlite:///./data/legal_hub.db"
# Or PostgreSQL with pgvector:
# DATABASE_URL="postgresql://username:password@localhost:5432/legal_hub"

# AI Inference (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embedding Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"
